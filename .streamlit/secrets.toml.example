# Template for .streamlit/secrets.toml (local) or the "Secrets" settings on Streamlit Cloud.
# Copy this file to .streamlit/secrets.toml and replace every value with your own.
# NEVER commit the real secrets.toml: it is excluded by .gitignore.

[snowflake]
account = "<SNOWFLAKE_ACCOUNT>"   # organization-account (e.g. myorg-myaccount) or legacy locator (e.g. xy12345.eu-central-2.aws)
user = "<SNOWFLAKE_USER>"
password = "<SNOWFLAKE_PASSWORD>"
role = "<SNOWFLAKE_ROLE>"
warehouse = "<SNOWFLAKE_WAREHOUSE>"
database = "<SNOWFLAKE_DATABASE>"
schema = "<SNOWFLAKE_SCHEMA>"
