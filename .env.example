# Template for the local .env file read by scripts/03_load_to_snowflake.py.
# Copy this file to .env in the project root and replace every value.
# NEVER commit the real .env: it is excluded by .gitignore.
# Variables already set in your terminal take precedence over this file.

SNOWFLAKE_ACCOUNT=<SNOWFLAKE_ACCOUNT>
SNOWFLAKE_USER=<SNOWFLAKE_USER>
SNOWFLAKE_PASSWORD=<SNOWFLAKE_PASSWORD>
SNOWFLAKE_ROLE=<SNOWFLAKE_ROLE>
SNOWFLAKE_WAREHOUSE=<SNOWFLAKE_WAREHOUSE>
SNOWFLAKE_DATABASE=<SNOWFLAKE_DATABASE>

# Optional: raw schema name (default RAW_CRIME_DATA). dbt reads the same variable.
# RAW_SCHEMA=RAW_CRIME_DATA
